---
import { url } from '../../lib/url';
const links = [
  { href: url('/v7/#services'), label: 'Programs' },
  { href: url('/v7/#approach'), label: 'Approach' },
  { href: url('/v7/#faculty'),  label: 'Faculty' },
  { href: url('/v7/#faq'),      label: 'FAQ' },
];
---
<nav>
  <a href={url('/v7/')} class="brand">
    <span class="brand-mark">Æ</span>
    <span class="brand-name">Athenaeum</span>
  </a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href={url('/v7/book/')} class="nav-cta">Book a Consult <span class="arr">→</span></a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1.4rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--v7-border);
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--v7-text);
  }
  .brand-mark {
    font-family: "Newsreader", serif;
    font-style: italic;
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--v7-text-strong);
  }
  .brand-name {
    font-family: "Newsreader", serif;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }
  .nav-links a {
    font-family: "Inter", sans-serif;
    color: var(--v7-text-muted);
    font-size: 0.84rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--v7-text); }
  .nav-cta {
    font-family: "Newsreader", serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--v7-text);
    border-bottom: 1px solid var(--v7-text);
    padding-bottom: 0.2rem;
    transition: opacity 0.2s;
  }
  .nav-cta .arr { font-style: normal; }
  .nav-cta:hover { opacity: 0.7; }
  @media (max-width: 768px) {
    nav { padding: 1rem 1.2rem; }
    .nav-links { display: none; }
  }
</style>
