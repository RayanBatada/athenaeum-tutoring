---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/v5/PageLayout.astro';
import { services } from '../../data/services';
import { homepageFAQs } from '../../data/faqs';
import { reasons } from '../../data/why-different';
import { url } from '../../lib/url';

const tutors = (await getCollection('tutors')).slice(0, 4);
const featuredService = services.find((s) => s.slug === 'sat') ?? services[0];
const otherServices = services.filter((s) => s.slug !== featuredService.slug);
const statements = reasons.slice(0, 4);
const universities = ['Harvard', 'Yale', 'Princeton', 'Columbia', 'Brown', 'Dartmouth', 'Cornell', 'UPenn', 'MIT', 'Stanford'];
---
<PageLayout title="Athenaeum — Top scores. Top schools.">
  <!-- Hero: editorial statement -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-meta v5-reveal">
        <span class="hero-index">001 · WELCOME</span>
        <span class="hero-divider"></span>
        <span class="hero-loc">EST. ATHENAEUM &amp; CO.</span>
      </div>
      <h1 class="hero-headline fraunces v5-reveal">
        One-on-one.<br />
        <em>Top scores.</em><br />
        <span class="hero-bottom">Top schools.</span>
      </h1>
      <div class="hero-aside v5-reveal">
        <p>A private studio for college-bound students. <em class="fraunces">AP, SAT, ACT,</em> and college counseling, taught by current Harvard, Yale, Princeton, and Columbia scholars.</p>
        <div class="hero-cta-row">
          <a href={url('/v5/book/')} class="btn">Schedule a Free Consult</a>
          <a href="#programs" class="btn-quiet">Read the Programs →</a>
        </div>
      </div>
    </div>

    <!-- Big floating "01" decoration -->
    <div class="hero-bigchar fraunces" aria-hidden="true">01</div>
  </section>

  <!-- University marquee strip — bigger, editorial -->
  <section class="strip">
    <div class="strip-track">
      {[...universities, ...universities].map((u) => (
        <span class="strip-item fraunces">{u}<span class="strip-sep">✦</span></span>
      ))}
    </div>
  </section>

  <!-- Programs (bento) -->
  <section id="programs" class="section">
    <div class="section-head v5-reveal">
      <span class="section-no">002 · PROGRAMS</span>
      <h2 class="section-h fraunces">Four programs. <em>Taught one to one.</em></h2>
    </div>
    <div class="bento v5-reveal">
      <article class="bento-card bento-feature">
        <div class="bento-tag">FEATURED</div>
        <div class="bento-meta">
          <span class="bento-no fraunces">I.</span>
          <span class="bento-cadence">{featuredService.cadence}</span>
        </div>
        <h3 class="fraunces">{featuredService.longName}</h3>
        <p class="bento-tagline">{featuredService.tagline}</p>
        <ul>
          {featuredService.topics.map((t) => <li>{t}</li>)}
        </ul>
        <div class="bento-foot">
          <span>From ${featuredService.startingAtHourly}/hr</span>
          <span class="bento-arrow">→</span>
        </div>
      </article>

      {otherServices.map((s, i) => (
        <article class="bento-card">
          <div class="bento-meta">
            <span class="bento-no fraunces">{['II.', 'III.', 'IV.'][i]}</span>
            <span class="bento-cadence">{s.cadence}</span>
          </div>
          <h3 class="fraunces">{s.longName}</h3>
          <p class="bento-blurb">{s.blurb}</p>
          <div class="bento-foot">
            <span>From ${s.startingAtHourly}/hr</span>
            <span class="bento-arrow">→</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Approach: big statements -->
  <section id="approach" class="section section-approach">
    <div class="section-head v5-reveal">
      <span class="section-no">003 · APPROACH</span>
      <h2 class="section-h fraunces">Built around <em>the student,</em><br />not the syllabus.</h2>
    </div>
    <div class="statements v5-reveal">
      {statements.map((r, i) => (
        <div class="statement">
          <div class="statement-no fraunces">{String(i + 1).padStart(2, '0')}</div>
          <h4 class="fraunces">{r.title}{r.titleSerif && <> <em>{r.titleSerif}</em></>}</h4>
          <p>{r.body}</p>
        </div>
      ))}
    </div>
    <div class="approach-quote v5-reveal">
      <span class="approach-mark fraunces">"</span>
      <p class="fraunces">
        The plan is yours. The pace is yours. The tutor is the top scorer in the room.
      </p>
      <span class="approach-attr">— The Athenaeum Method</span>
    </div>
  </section>

  <!-- Faculty: editorial portrait cards -->
  <section id="faculty" class="section">
    <div class="section-head v5-reveal">
      <span class="section-no">004 · FACULTY</span>
      <h2 class="section-h fraunces">Tutors who <em>recently sat</em> these exams.</h2>
    </div>
    <div class="faculty-row v5-reveal">
      {tutors.map((t, i) => (
        <figure class="faculty-card">
          <div class={`faculty-portrait ${t.data.cardGradient}`}>
            <span class="faculty-mono fraunces">{t.data.monogram}</span>
            <span class="faculty-edge fraunces">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <figcaption>
            <h4 class="fraunces">{t.data.name}</h4>
            <p class="faculty-school">{t.data.school} <em>{t.data.classYear}</em></p>
            <p class="faculty-sub">{t.data.subjects.slice(0, 3).join(' · ')}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- FAQ: oversized editorial Q&A -->
  <section class="section section-faq">
    <div class="section-head v5-reveal">
      <span class="section-no">005 · INQUIRIES</span>
      <h2 class="section-h fraunces">Frequently <em>asked.</em></h2>
    </div>
    <div class="faq-list v5-reveal">
      {homepageFAQs.map((item, i) => (
        <details class="faq">
          <summary>
            <span class="faq-num fraunces">{String(i + 1).padStart(2, '0')}.</span>
            <span class="faq-q fraunces" set:html={item.question.replace(/<span class='serif'>/g, '<em>').replace(/<\/span>/g, '</em>')} />
            <span class="faq-plus">+</span>
          </summary>
          <div class="faq-a">{item.answer}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- Final big CTA -->
  <section class="final">
    <div class="final-inner v5-reveal">
      <span class="final-no">— 006 · BEGIN —</span>
      <h2 class="fraunces">
        Apply for a<br />
        <em>consultation.</em>
      </h2>
      <p>Thirty minutes. No commitment. We'll tell you, honestly, if Athenaeum is the right fit.</p>
      <a href={url('/v5/book/')} class="btn-big">Schedule Free Consult</a>
    </div>
  </section>
</PageLayout>

<style>
  /* ───────── Hero ───────── */
  .hero {
    position: relative;
    padding: 6rem 2.5rem 5rem;
    border-bottom: 1px solid var(--v5-border);
    overflow: hidden;
  }
  .hero-grid {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    color: var(--v5-text-muted);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    font-weight: 500;
  }
  .hero-index { color: var(--v5-accent); font-weight: 700; }
  .hero-divider {
    flex: 0 0 60px;
    height: 1px;
    background: var(--v5-border-strong);
  }
  .hero-headline {
    font-size: clamp(3.5rem, 13vw, 12rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.04em;
    margin-bottom: 2.5rem;
    max-width: 90%;
  }
  .hero-headline em {
    color: var(--v5-accent);
    font-style: italic;
    font-weight: 400;
  }
  .hero-headline .hero-bottom {
    display: inline-block;
    border-bottom: 4px solid var(--v5-accent);
    padding-bottom: 0.05em;
  }
  .hero-aside {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    align-items: end;
    margin-top: 2.5rem;
    border-top: 1px solid var(--v5-border);
    padding-top: 2rem;
  }
  .hero-aside p {
    font-size: 1.15rem;
    color: var(--v5-text-muted);
    line-height: 1.6;
    max-width: 460px;
  }
  .hero-aside em {
    color: var(--v5-accent);
    font-style: italic;
  }
  .hero-cta-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .btn {
    background: var(--v5-accent);
    color: var(--v5-bg);
    padding: 1rem 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: all 0.2s;
    border-radius: 0;
  }
  .btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--v5-text);
  }
  .btn-quiet {
    color: var(--v5-text-muted);
    font-size: 0.95rem;
    border-bottom: 1px solid var(--v5-text-muted);
    padding-bottom: 0.2rem;
    transition: all 0.2s;
  }
  .btn-quiet:hover {
    color: var(--v5-accent);
    border-color: var(--v5-accent);
  }
  .hero-bigchar {
    position: absolute;
    top: 50%;
    right: -2rem;
    transform: translateY(-50%) rotate(-90deg);
    font-size: 14rem;
    font-weight: 500;
    color: var(--v5-bg-elevated);
    line-height: 1;
    pointer-events: none;
    z-index: 1;
    font-style: italic;
  }

  /* ───────── Marquee strip ───────── */
  .strip {
    background: var(--v5-bg);
    border-bottom: 1px solid var(--v5-border);
    padding: 1.5rem 0;
    overflow: hidden;
  }
  .strip-track {
    display: flex;
    gap: 2.5rem;
    white-space: nowrap;
    animation: scroll 40s linear infinite;
  }
  .strip-item {
    font-size: 2rem;
    font-weight: 500;
    color: var(--v5-text);
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    font-style: italic;
  }
  .strip-sep {
    color: var(--v5-accent);
    font-size: 1rem;
    font-style: normal;
    margin-left: 2.5rem;
  }
  @keyframes scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ───────── Sections ───────── */
  .section {
    max-width: 1400px;
    margin: 0 auto;
    padding: 7rem 2.5rem;
  }
  .section-head {
    margin-bottom: 4rem;
  }
  .section-no {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: var(--v5-accent);
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  .section-h {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 900px;
  }
  .section-h em {
    color: var(--v5-accent);
    font-style: italic;
  }

  /* ───────── Bento programs ───────── */
  .bento {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 1rem;
  }
  .bento-card {
    background: var(--v5-bg-elevated);
    border: 1px solid var(--v5-border);
    padding: 2rem 1.8rem 1.6rem;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .bento-card:hover {
    background: var(--v5-bg-elevated-hover);
    border-color: var(--v5-accent);
  }
  .bento-feature {
    grid-row: span 3;
    padding: 2.5rem 2.5rem 2rem;
    background: linear-gradient(135deg, var(--v5-bg-elevated), rgba(253, 222, 0, 0.05));
    border-color: var(--v5-accent);
  }
  .bento-tag {
    display: inline-block;
    background: var(--v5-accent);
    color: var(--v5-bg);
    padding: 0.3rem 0.7rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 1.5rem;
    align-self: flex-start;
  }
  .bento-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .bento-no {
    font-size: 1.6rem;
    color: var(--v5-accent);
    font-style: italic;
  }
  .bento-cadence {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--v5-text-muted);
    text-transform: uppercase;
    font-weight: 600;
  }
  .bento-card h3 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.98;
    font-weight: 500;
    margin-bottom: 0.8rem;
    color: var(--v5-text);
    letter-spacing: -0.02em;
  }
  .bento-feature h3 {
    font-size: clamp(2.8rem, 6vw, 5rem);
  }
  .bento-tagline {
    font-style: italic;
    font-family: "Fraunces", serif;
    color: var(--v5-accent);
    font-size: 1.3rem;
    line-height: 1.3;
    margin-bottom: 1.3rem;
  }
  .bento-blurb {
    color: var(--v5-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1rem;
    flex-grow: 1;
  }
  .bento-feature ul {
    list-style: none;
    margin: 0 0 2rem;
    flex-grow: 1;
  }
  .bento-feature li {
    color: var(--v5-text-muted);
    padding: 0.55rem 0;
    border-bottom: 1px dotted var(--v5-border);
    font-size: 1rem;
  }
  .bento-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.8rem;
    border-top: 1px solid var(--v5-border);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--v5-text);
  }
  .bento-arrow {
    color: var(--v5-accent);
    font-size: 1.2rem;
    transition: transform 0.2s;
  }
  .bento-card:hover .bento-arrow {
    transform: translateX(6px);
  }

  /* ───────── Approach ───────── */
  .section-approach {
    background: var(--v5-bg-soft);
    max-width: none;
    border-top: 1px solid var(--v5-border);
    border-bottom: 1px solid var(--v5-border);
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }
  .section-approach > * {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }
  .statements {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 4rem;
    margin-bottom: 5rem;
  }
  .statement {
    border-top: 2px solid var(--v5-border-strong);
    padding-top: 1.5rem;
  }
  .statement-no {
    font-size: 1.2rem;
    color: var(--v5-accent);
    font-style: italic;
    margin-bottom: 0.7rem;
  }
  .statement h4 {
    font-size: 1.9rem;
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--v5-text);
    margin-bottom: 0.7rem;
  }
  .statement h4 em {
    color: var(--v5-accent);
    font-style: italic;
  }
  .statement p {
    color: var(--v5-text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .approach-quote {
    text-align: center;
    max-width: 880px;
    margin: 0 auto;
    padding: 3rem 0;
    border-top: 1px solid var(--v5-border);
  }
  .approach-mark {
    display: inline-block;
    font-size: 6rem;
    color: var(--v5-accent);
    line-height: 0.5;
    margin-bottom: 1rem;
  }
  .approach-quote p {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.2;
    color: var(--v5-text);
    font-style: italic;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .approach-attr {
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--v5-text-muted);
    text-transform: uppercase;
  }

  /* ───────── Faculty ───────── */
  .faculty-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .faculty-card {
    margin: 0;
  }
  .faculty-portrait {
    aspect-ratio: 4/5;
    border: 1px solid var(--v5-border-strong);
    margin-bottom: 1.2rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: all 0.3s;
  }
  .faculty-portrait:hover { border-color: var(--v5-accent); }
  .faculty-portrait.lime      { background: linear-gradient(160deg, #1a1a2e, #0d0d1c); }
  .faculty-portrait.tangerine { background: linear-gradient(160deg, #2a1a14, #1c0e08); }
  .faculty-portrait.plum      { background: linear-gradient(160deg, #1a1230, #0e0820); }
  .faculty-portrait.ink       { background: linear-gradient(160deg, #16161a, #0a0a0a); }
  .faculty-mono {
    font-size: 6.5rem;
    color: var(--v5-text);
    font-style: italic;
    line-height: 1;
    font-weight: 500;
  }
  .faculty-edge {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    font-size: 1rem;
    color: var(--v5-accent);
    font-style: italic;
  }
  .faculty-card h4 {
    font-size: 1.45rem;
    color: var(--v5-text);
    margin-bottom: 0.3rem;
    line-height: 1.1;
    font-weight: 500;
  }
  .faculty-school {
    color: var(--v5-accent);
    font-size: 0.92rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .faculty-school em {
    color: var(--v5-text-muted);
    font-style: italic;
  }
  .faculty-sub {
    color: var(--v5-text-muted);
    font-size: 0.85rem;
  }

  /* ───────── FAQ ───────── */
  .section-faq {
    background: var(--v5-bg-soft);
    max-width: none;
    border-top: 1px solid var(--v5-border);
    padding-left: 2.5rem;
    padding-right: 2.5rem;
  }
  .section-faq > * {
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
  }
  .faq-list {
    border-top: 1px solid var(--v5-border);
  }
  .faq {
    border-bottom: 1px solid var(--v5-border);
    padding: 2rem 0;
    cursor: pointer;
  }
  .faq summary {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-num {
    color: var(--v5-accent);
    font-size: 1.1rem;
    font-style: italic;
    min-width: 2.5rem;
  }
  .faq-q {
    flex: 1;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--v5-text);
  }
  .faq-q em {
    color: var(--v5-accent);
    font-style: italic;
  }
  .faq-plus {
    color: var(--v5-accent);
    font-size: 1.5rem;
    transition: transform 0.3s;
  }
  .faq[open] .faq-plus { transform: rotate(45deg); }
  .faq-a {
    padding: 1rem 0 0 4rem;
    color: var(--v5-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 760px;
  }

  /* ───────── Final CTA ───────── */
  .final {
    background: var(--v5-bg);
    padding: 8rem 2.5rem;
    border-top: 1px solid var(--v5-border);
    text-align: center;
  }
  .final-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .final-no {
    display: block;
    color: var(--v5-accent);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    font-weight: 700;
    margin-bottom: 1.8rem;
  }
  .final h2 {
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: -0.035em;
    margin-bottom: 2rem;
  }
  .final h2 em {
    color: var(--v5-accent);
    font-style: italic;
  }
  .final p {
    color: var(--v5-text-muted);
    font-size: 1.2rem;
    max-width: 580px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  .btn-big {
    background: var(--v5-accent);
    color: var(--v5-bg);
    padding: 1.4rem 2.5rem;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: inline-block;
    transition: all 0.25s;
  }
  .btn-big:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--v5-text);
  }

  /* ───────── Responsive ───────── */
  @media (max-width: 1024px) {
    .hero-aside { grid-template-columns: 1fr; }
    .bento { grid-template-columns: 1fr; }
    .bento-feature { grid-row: span 1; }
    .statements, .faculty-row { grid-template-columns: 1fr 1fr; }
    .hero-bigchar { display: none; }
  }
  @media (max-width: 640px) {
    .hero { padding: 4rem 1.2rem 3rem; }
    .section { padding: 5rem 1.2rem; }
    .section-approach, .section-faq { padding: 5rem 1.2rem; }
    .statements, .faculty-row { grid-template-columns: 1fr; }
