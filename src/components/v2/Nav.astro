---
import { url } from '../../lib/url';

const links = [
  { href: url('/v2/#services'),       label: 'Services' },
  { href: url('/v2/#approach'),       label: 'Approach' },
  { href: url('/v2/#faculty'),        label: 'Faculty' },
  { href: url('/v2/#faq'),            label: 'FAQ' },
];
---
<nav>
  <a href={url('/v2/')} class="brand">
    <span class="brand-mark"></span>
    Athenaeum
  </a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href={url('/v2/book/')} class="nav-cta">Schedule Consult →</a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--v2-border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--v2-text);
  }
  .brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--v2-accent) 0%, #8b85ff 100%);
  }
  .nav-links {
    display: flex;
    gap: 1.8rem;
    list-style: none;
  }
  .nav-links a {
    color: var(--v2-text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--v2-text); }

  .nav-cta {
    background: var(--v2-bg-dark);
    color: var(--v2-bg);
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.15s;
  }
  .nav-cta:hover { background: #08243d; transform: translateY(-1px); }

  @media (max-width: 768px) {
    nav { padding: 0.9rem 1.2rem; }
    .nav-links { display: none; }
  }
</style>
