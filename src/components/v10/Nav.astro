---
import { url } from '../../lib/url';
const links = [
  { href: url('/v10/#programs'), label: 'Programs' },
  { href: url('/v10/#approach'), label: 'Approach' },
  { href: url('/v10/#faculty'),  label: 'Faculty' },
  { href: url('/v10/#faq'),      label: 'FAQ' },
];
---
<nav>
  <a href={url('/v10/')} class="brand">
    Athenaeum<span class="brand-dot">.</span>
  </a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href={url('/v10/book/')} class="nav-cta">Book a Consult</a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1.2rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--v10-border);
  }
  .brand {
    font-family: "Bricolage Grotesque", sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    color: var(--v10-ink);
  }
  .brand-dot { color: var(--v10-tangerine); }
  .nav-links { display: flex; gap: 1.8rem; list-style: none; }
  .nav-links a {
    color: var(--v10-ink-soft);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--v10-ink); }
  .nav-cta {
    background: var(--v10-ink);
    color: var(--v10-bg);
    padding: 0.65rem 1.2rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
  }
  .nav-cta:hover { background: var(--v10-tangerine); }
  @media (max-width: 768px) {
    nav { padding: 0.9rem 1.2rem; }
    .nav-links { display: none; }
  }
</style>
