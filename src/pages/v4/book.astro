---
import PageLayout from '../../layouts/v4/PageLayout.astro';
import CalEmbed from '../../components/CalEmbed.astro';
import { site } from '../../data/site';
---
<PageLayout title="Book — Athenaeum" description="Schedule a free 30-min consult.">
  <section class="book-hero">
    <div class="aurora">
      <div class="aurora-blob a1"></div>
      <div class="aurora-blob a2"></div>
    </div>
    <div class="hero-inner v4-reveal">
      <span class="pill">Book your seat</span>
      <h1>A free <span class="gradient-text">30-minute consult.</span></h1>
      <p>Tell us your timeline, target score, and the subjects you're focused on. We'll review fit and recommend the right plan.</p>
    </div>
  </section>

  <section class="cal-section v4-reveal">
    <div class="cal-card">
      <CalEmbed calLink={site.consultCalLink} embedId="cal-v4-consult" namespace="v4consult" />
    </div>
  </section>
</PageLayout>

<style>
  .book-hero {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 6rem 2rem 3rem;
    text-align: center;
    overflow: hidden;
  }
  .aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
  }
  .aurora-blob.a1 {
    width: 400px; height: 400px;
    top: -100px; left: -100px;
    background: radial-gradient(circle, var(--v4-accent), transparent 70%);
  }
  .aurora-blob.a2 {
    width: 380px; height: 380px;
    top: -50px; right: -100px;
    background: radial-gradient(circle, var(--v4-mint), transparent 70%);
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  .pill {
    display: inline-block;
    background: var(--v4-bg-elevated);
    border: 1px solid var(--v4-border);
    color: var(--v4-text-muted);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.4rem;
  }
  .book-hero h1 {
    font-family: "Inter", sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 1.1rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--v4-accent) 0%, var(--v4-mint) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .book-hero p {
    font-size: 1.1rem;
    color: var(--v4-text-muted);
    line-height: 1.55;
  }
  .cal-section {
    max-width: 980px;
    margin: 0 auto;
    padding: 2rem 2rem 6rem;
  }
  .cal-card {
    background: var(--v4-text);
    border: 1px solid var(--v4-border-strong);
    border-radius: 16px;
    padding: 0.8rem;
  }
  @media (max-width: 640px) {
    .book-hero { padding: 4rem 1.2rem 2rem; }
    .cal-section { padding: 1rem 1.2rem 4rem; }
  }
</style>
