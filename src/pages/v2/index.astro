---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/v2/PageLayout.astro';
import Button from '../../components/v2/Button.astro';
import { services } from '../../data/services';
import { homepageFAQs } from '../../data/faqs';
import { reasons } from '../../data/why-different';
import { url } from '../../lib/url';

const tutors = (await getCollection('tutors')).slice(0, 4);
const topReasons = reasons.slice(0, 6);
---
<PageLayout title="Athenaeum — One-on-one Ivy League tutoring.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-pill v2-reveal">
      <span class="pulse"></span>
      One-on-one · Top Ivy League tutors
    </div>
    <h1 class="hero-title v2-reveal">
      Test prep & college counseling,<br />
      <span class="muted">done right.</span>
    </h1>
    <p class="hero-sub v2-reveal">
      One-on-one tutoring taught by current students from Harvard, Yale, Princeton, and Columbia.
      Custom lesson plans. Hand-graded homework. Built around your timeline.
    </p>
    <div class="hero-cta v2-reveal">
      <Button href={url('/v2/book/')} variant="primary" size="lg">Schedule Free Consult</Button>
      <Button href="#services" variant="outline" size="lg">See Services</Button>
    </div>
    <div class="hero-trust v2-reveal">
      <span>30-min free consult</span>
      <span class="dot"></span>
      <span>First-week money-back</span>
      <span class="dot"></span>
      <span>No long-term contracts</span>
    </div>
  </section>

  <!-- University strip -->
  <section class="logos">
    <div class="logos-inner">
      <span class="logos-label">Tutors from</span>
      <div class="logos-row">
        <span>Harvard</span><span>Yale</span><span>Princeton</span><span>Columbia</span><span>Brown</span><span>Cornell</span><span>UPenn</span><span>MIT</span><span>Stanford</span>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="section-head v2-reveal">
      <h2>Pick your test, or your college list.</h2>
      <p>Four programs. One-on-one. Tailored to where your student is starting and where they need to be.</p>
    </div>
    <div class="services-grid v2-reveal">
      {services.map((s) => (
        <div class="service-card">
          <div class="service-tag">{s.cadence}</div>
          <h3>{s.name === 'College Counseling' ? 'College Counseling' : `${s.name} Tutoring`}</h3>
          <p>{s.blurb}</p>
          <ul class="service-topics">
            {s.topics.slice(0, 3).map((t) => <li>{t}</li>)}
          </ul>
          <div class="service-foot">
            <span class="service-price">Starting at ${s.startingAtHourly}/hr</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="section section-tinted">
    <div class="section-head v2-reveal">
      <h2>How we're different.</h2>
      <p>What separates Athenaeum from a big tutoring chain.</p>
    </div>
    <div class="approach-grid v2-reveal">
      {topReasons.map((r) => (
        <div class="approach-card">
          <div class="approach-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h4>{r.title}{r.titleSerif && <> {r.titleSerif}</>}</h4>
            <p>{r.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="section-head v2-reveal">
      <h2>From first consult to test day.</h2>
      <p>Three steps. No surprises.</p>
    </div>
    <div class="how-grid v2-reveal">
      <div class="how-step">
        <div class="how-num">01</div>
        <h4>Free 30-min consult</h4>
        <p>A quick call: what test, current level, target score, timeline. We recommend the right tutor match.</p>
      </div>
      <div class="how-step">
        <div class="how-num">02</div>
        <h4>Get matched</h4>
        <p>Within a week, you'll meet your tutor and start the diagnostic week.</p>
      </div>
      <div class="how-step">
        <div class="how-num">03</div>
        <h4>Weekly 1-on-1s</h4>
        <p>Weekly sessions, hand-graded homework, practice tests, and a test-day strategy session.</p>
      </div>
    </div>
  </section>

  <!-- Faculty -->
  <section id="faculty" class="section section-tinted">
    <div class="section-head v2-reveal">
      <h2>Taught by people who recently sat these exams.</h2>
      <p>Every tutor is a current Ivy League or peer-university student who scored at the top of the exam they teach.</p>
    </div>
    <div class="faculty-grid v2-reveal">
      {tutors.map((t) => (
        <div class="faculty-card">
          <div class={`faculty-avatar ${t.data.cardGradient}`}>
            <span>{t.data.monogram}</span>
          </div>
          <h4>{t.data.name}</h4>
          <p class="faculty-school">{t.data.school} {t.data.classYear}</p>
          <p class="faculty-subjects">{t.data.subjects.slice(0, 3).join(' · ')}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section">
    <div class="section-head center v2-reveal">
      <h2>Frequently asked.</h2>
    </div>
    <div class="faq-wrap v2-reveal">
      {homepageFAQs.map((item) => (
        <details class="faq-item">
          <summary>
            <span set:html={item.question.replace(/<span class='serif'>/g, '<em>').replace(/<\/span>/g, '</em>')} />
            <span class="faq-chevron">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </summary>
          <div class="faq-body">{item.answer}</div>
        </details>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta">
    <div class="final-cta-inner v2-reveal">
      <h2>Reserve your free consult.</h2>
      <p>30 minutes. No commitment. We'll tell you honestly if Athenaeum is the right fit.</p>
      <Button href={url('/v2/book/')} variant="primary" size="lg">Schedule Free Consult</Button>
    </div>
  </section>
</PageLayout>

<style>
  /* ───────── Hero ───────── */
  .hero {
    max-width: 920px;
    margin: 0 auto;
    padding: 7rem 2rem 5rem;
    text-align: center;
  }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--v2-bg-subtle);
    border: 1px solid var(--v2-border);
    color: var(--v2-text-muted);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.8rem;
  }
  .hero-pill .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--v2-accent);
    box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.18);
  }
  .hero-title {
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin-bottom: 1.5rem;
  }
  .hero-title .muted {
    color: var(--v2-text-muted);
    font-weight: 600;
  }
  .hero-sub {
    font-size: 1.2rem;
    color: var(--v2-text-muted);
    max-width: 660px;
    margin: 0 auto 2.2rem;
    line-height: 1.55;
  }
  .hero-cta {
    display: inline-flex;
    gap: 0.8rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-trust {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    color: var(--v2-text-faint);
    font-size: 0.9rem;
  }
  .hero-trust .dot {
    width: 3px;
    height: 3px;
    background: var(--v2-text-faint);
    border-radius: 50%;
  }

  /* ───────── Logos ───────── */
  .logos {
    background: var(--v2-bg);
    padding: 2.5rem 2rem 4rem;
    border-bottom: 1px solid var(--v2-border);
  }
  .logos-inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .logos-label {
    display: block;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--v2-text-faint);
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .logos-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.2rem;
  }
  .logos-row span {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--v2-text-muted);
    letter-spacing: -0.01em;
  }

  /* ───────── Sections ───────── */
  .section {
    padding: 6.5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .section.section-tinted {
    background: var(--v2-bg-subtle);
    max-width: none;
    margin: 0;
    border-top: 1px solid var(--v2-border);
    border-bottom: 1px solid var(--v2-border);
  }
  .section.section-tinted > * {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head {
    margin-bottom: 3.5rem;
    max-width: 720px;
  }
  .section-head.center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .section-head h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 0.85rem;
  }
  .section-head p {
    font-size: 1.1rem;
    color: var(--v2-text-muted);
    line-height: 1.55;
  }

  /* ───────── Services ───────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .service-card {
    border: 1px solid var(--v2-border);
    border-radius: 16px;
    padding: 1.8rem;
    background: var(--v2-bg-card);
    display: flex;
    flex-direction: column;
    transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    min-height: 320px;
  }
  .service-card:hover {
    border-color: var(--v2-border-strong);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -10px rgba(10, 37, 64, 0.1);
  }
  .service-tag {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--v2-accent);
    margin-bottom: 0.6rem;
  }
  .service-card h3 {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.65rem;
  }
  .service-card p {
    font-size: 0.92rem;
    color: var(--v2-text-muted);
    line-height: 1.55;
    margin-bottom: 1.1rem;
    flex-grow: 1;
  }
  .service-topics {
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
  }
  .service-topics li {
    font-size: 0.85rem;
    color: var(--v2-text-muted);
    padding: 0.4rem 0;
    border-top: 1px solid var(--v2-border);
  }
  .service-topics li:first-child { border-top: none; }
  .service-foot {
    border-top: 1px solid var(--v2-border);
    padding-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--v2-text);
  }

  /* ───────── Approach ───────── */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 3rem;
  }
  .approach-card {
    display: flex;
    gap: 1rem;
  }
  .approach-icon {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--v2-bg);
    border: 1px solid var(--v2-border);
    color: var(--v2-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .approach-icon svg { width: 18px; height: 18px; }
  .approach-card h4 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.3rem;
  }
  .approach-card p {
    font-size: 0.93rem;
    color: var(--v2-text-muted);
    line-height: 1.55;
  }

  /* ───────── How ───────── */
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .how-step {
    padding: 1.5rem 0;
    border-top: 1px solid var(--v2-text);
  }
  .how-num {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--v2-text-faint);
    margin-bottom: 1.2rem;
  }
  .how-step h4 {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 0.6rem;
  }
  .how-step p {
    font-size: 0.96rem;
    color: var(--v2-text-muted);
    line-height: 1.55;
  }

  /* ───────── Faculty ───────── */
  .faculty-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .faculty-card {
    text-align: center;
  }
  .faculty-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin: 0 auto 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--v2-bg);
  }
  .faculty-avatar.lime      { background: linear-gradient(135deg, #4f46e5, #635bff); }
  .faculty-avatar.tangerine { background: linear-gradient(135deg, #ea580c, #f97316); }
  .faculty-avatar.plum      { background: linear-gradient(135deg, #6d28d9, #8b5cf6); }
  .faculty-avatar.ink       { background: linear-gradient(135deg, #0a2540, #1e3a5f); }

  .faculty-card h4 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.2rem;
  }
  .faculty-school {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--v2-accent);
    margin-bottom: 0.3rem;
  }
  .faculty-subjects {
    font-size: 0.85rem;
    color: var(--v2-text-muted);
  }

  /* ───────── FAQ ───────── */
  .faq-wrap {
    max-width: 760px;
    margin: 0 auto;
  }
  .faq-item {
    border-top: 1px solid var(--v2-border);
    padding: 1.4rem 0;
  }
  .faq-item:last-child { border-bottom: 1px solid var(--v2-border); }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    color: var(--v2-text);
  }
  .faq-item summary :global(em) {
    font-style: italic;
    color: var(--v2-accent);
    font-weight: 600;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-chevron {
    color: var(--v2-text-muted);
    transition: transform 0.25s;
  }
  .faq-chevron svg { width: 18px; height: 18px; display: block; }
  .faq-item[open] .faq-chevron { transform: rotate(180deg); }
  .faq-body {
    padding-top: 0.8rem;
    color: var(--v2-text-muted);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  /* ───────── Final CTA ───────── */
  .final-cta {
    background: var(--v2-bg-dark);
    color: var(--v2-bg);
    padding: 7rem 2rem;
    text-align: center;
  }
  .final-cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .final-cta h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .final-cta p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.1rem;
    line-height: 1.55;
    margin-bottom: 2rem;
  }
  .final-cta :global(.v2-btn.primary) {
    background: var(--v2-bg);
    color: var(--v2-bg-dark);
    border-color: var(--v2-bg);
  }
  .final-cta :global(.v2-btn.primary:hover) {
    background: #f0f0f0;
  }

  /* ───────── Responsive ───────── */
  @media (max-width: 1024px) {
    .services-grid, .faculty-grid { grid-template-columns: repeat(2, 1fr); }
    .approach-grid { grid-template-columns: 1fr; }
    .how-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 4rem 1.2rem 3rem; }
    .section { padding: 4rem 1.2rem; }
    .section.section-tinted { padding: 4rem 1.2rem; }
    .logos { padding: 2rem 1.2rem; }
    .services-grid, .faculty-grid { grid-template-columns: 1fr; }
    .final-cta { padding: 5rem 1.2rem; }
  }
</style>
