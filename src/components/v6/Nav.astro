---
import { url } from '../../lib/url';
const links = [
  { href: url('/v6/#services'), label: 'Services' },
  { href: url('/v6/#approach'), label: 'Approach' },
  { href: url('/v6/#faculty'),  label: 'Faculty' },
  { href: url('/v6/#faq'),      label: 'FAQ' },
];
---
<nav>
  <a href={url('/v6/')} class="brand">
    <span class="brand-mark"></span>
    Athenaeum
  </a>
  <ul class="nav-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href={url('/v6/book/')} class="nav-cta">Book Consult</a>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1.1rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10, 10, 12, 0.78);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--v6-border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    color: var(--v6-text);
  }
  .brand-mark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--v6-text);
  }
  .nav-links {
    display: flex;
    gap: 1.8rem;
    list-style: none;
  }
  .nav-links a {
    color: var(--v6-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: var(--v6-text); }
  .nav-cta {
    background: var(--v6-text);
    color: var(--v6-bg);
    padding: 0.55rem 1rem;
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.15s;
  }
  .nav-cta:hover {
    background: var(--v6-text-muted);
  }
  @media (max-width: 768px) {
    nav { padding: 0.9rem 1.2rem; }
    .nav-links { display: none; }
  }
</style>
