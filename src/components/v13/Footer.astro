---
import { url } from '../../lib/url';
---
<footer>
  <div class="footer-inner">
    <div class="footer-brand-block">
      <div class="brand">
        <span class="brand-emblem">A</span>
        <span class="brand-name">Athenaeum</span>
      </div>
      <p class="footer-tag">One-on-one and small-group preparation for the examinations that decide your trajectory. Taught by Ivy League scholars.</p>
    </div>
    <div class="footer-links">
      <div>
        <h4>Curriculum</h4>
        <a href={url('/v13/#curriculum')}>AP</a>
        <a href={url('/v13/#curriculum')}>SAT</a>
        <a href={url('/v13/#curriculum')}>ACT</a>
        <a href={url('/v13/#curriculum')}>College Counsel</a>
      </div>
      <div>
        <h4>Athenaeum</h4>
        <a href={url('/v13/#study')}>Forms of Study</a>
        <a href={url('/v13/#faculty')}>Faculty</a>
        <a href={url('/v13/book/')}>Apply</a>
      </div>
      <div>
        <h4>Correspondence</h4>
        <a href="mailto:hello@athenaeum.co">hello@athenaeum.co</a>
        <a href={url('/privacy')}>Privacy</a>
        <a href={url('/terms')}>Terms</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span class="rule"></span>
    <span><em>MMXXVI</em> · Athenaeum & Co. · All rights reserved.</span>
  </div>
</footer>

<style>
  footer { background: var(--v3-bg-deep); border-top: 1px solid var(--v3-border-gold); padding: 4.5rem 2.5rem 2.5rem; color: var(--v3-text); position: relative; z-index: 2; }
  .footer-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 2fr; gap: 4rem; padding-bottom: 3rem; border-bottom: 1px solid var(--v3-border); }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .brand-emblem { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border: 1.5px solid var(--v3-gold); color: var(--v3-gold); font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.4rem; border-radius: 50%; }
  .brand-name { font-family: 'Cormorant Garamond', serif; font-size: 1.7rem; font-weight: 500; letter-spacing: 0.02em; }
  .footer-tag { color: var(--v3-text-muted); font-size: 0.95rem; line-height: 1.6; max-width: 360px; }
  .footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .footer-links h4 { font-family: 'Cormorant Garamond', serif; font-size: 0.92rem; font-weight: 600; color: var(--v3-gold); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem; }
  .footer-links a { display: block; color: var(--v3-text-muted); font-size: 0.95rem; margin-bottom: 0.6rem; transition: color 0.2s; }
  .footer-links a:hover { color: var(--v3-gold); }
  .footer-bottom { max-width: 1200px; margin: 2rem auto 0; text-align: center; font-size: 0.85rem; color: var(--v3-text-faint); letter-spacing: 0.04em; }
  .footer-bottom em { color: var(--v3-gold); }
  .rule { display: inline-block; width: 70px; height: 1px; background: var(--v3-border-gold); vertical-align: middle; margin-right: 1rem; }
  @media (max-width: 768px) { .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; } .footer-links { grid-template-columns: 1fr 1fr; } }
</style>
